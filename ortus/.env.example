# ORTUS — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou para o arquivo de ambiente do
# servidor (/etc/ortus/ortus.env na VM; painel da Vercel). Nunca comite.
# Variável opcional fica VAZIA, sem marcador: um texto qualquer conta como
# "configurado" e o sistema tentaria usar.

# ---- Endereço público do Ortus (obrigatória em produção) ----
# Usada nos links de e-mail, no retorno do pagamento e no webhook.
NEXT_PUBLIC_APP_URL=

# ---- Supabase (obrigatórias) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ATENÇÃO: service role só no servidor. Nunca no aplicativo desktop.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# Pooler do Supabase para os scripts (npm test, db:audit, migrations, limpeza).
# Não é lida pelo site nem pelo aplicativo.
DATABASE_URL=

# ---- Rotinas do agendador (obrigatória em produção) ----
# Protege /api/lembretes/processar, /api/assinaturas/processar e
# /api/saude/vigia. Sem ela as três respondem 401.
CRON_SECRET=

# ---- Cloudflare R2 (fotos, logos e documentos) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLICO=ortus-publico
R2_BUCKET_PRIVADO=ortus-privado

# ---- E-mail (Resend) ----
# O remetente precisa ser de um domínio verificado na Resend
# (ex.: Ortus <nao-responda@seudominio.com.br>). Sem as duas, nenhum e-mail
# sai e as telas dizem isso.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Quem recebe relatos de bug/sugestão e alertas da operação, separados por
# vírgula. Vazio = e-mail de login de cada dono da plataforma.
# Com o banco fora, o vigia só consegue avisar quem estiver nesta lista.
ALERTA_EMAILS=

# ---- Pagamento (Mercado Pago, Checkout Pro) ----
# Sem as duas, a página pública não oferece assinatura (mostra o contato).
PAGAMENTO_PROVEDOR=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks), apontado para
# <NEXT_PUBLIC_APP_URL>/api/pagamentos/webhook com o evento "Pagamentos".
MERCADOPAGO_WEBHOOK_SECRET=
# Só em homologação (servidor de testes rodando em modo produção com a
# credencial TEST-… ou comprador de teste): 1 aceita pagamento de teste.
# Em produção, deixe vazio: credencial de teste trava a venda e pagamento de
# teste vai para conferência no painel, sem criar conta.
MERCADOPAGO_ACEITAR_TESTE=

# ---- Homologação (nunca em produção) ----
# 1 deixa o build de produção usar os serviços falsos apontados por
# ORTUS_TESTE_URL_RESEND, ORTUS_TESTE_URL_R2 e ORTUS_TESTE_URL_PAGAMENTO
# (lib/servicosExternos.ts). Só para servidor de demonstração.
ORTUS_HOMOLOGACAO=

# ---- Suporte (cartão da Ajuda e página de assinatura) ----
# Só dígitos, com DDI (ex.: 5511999990000). Lidas no build: defina também
# no build do aplicativo de computador.
NEXT_PUBLIC_SUPORTE_WHATSAPP_1=
NEXT_PUBLIC_SUPORTE_WHATSAPP_2=

# ---- SMS (Twilio, opcional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- WhatsApp (ver docs/WHATSAPP.md) ----
# 0 esconde a aba WhatsApp e os botões passam a abrir o wa.me.
NEXT_PUBLIC_WHATSAPP_ATIVO=1
# Produção com processo sempre ligado: as duas juntas.
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_SECRET=
# Em produção o site só sobe o serviço sozinho com 1 (o padrão é a unidade systemd).
WHATSAPP_GATEWAY_AUTOSTART=
