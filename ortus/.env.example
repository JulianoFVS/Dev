# ORTUS — variáveis de ambiente
# Copie para .env.local e preencha. Nunca comite .env.local.

# ---- Supabase (obrigatórias) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ATENÇÃO: service role só pode existir no servidor (Vercel env / .env.local).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Pooler do Supabase para os scripts (Transaction mode, porta 6543).
DATABASE_URL=

# ---- Cron / rotinas (obrigatória em produção) ----
# Protege GET /api/lembretes/processar. Sem ela a rota responde 401.
CRON_SECRET=

# ---- Cloudflare R2 (opcional) ----
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ---- Comunicação (opcional) ----
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_SECRET=
NEXT_PUBLIC_WHATSAPP_ATIVO=1
