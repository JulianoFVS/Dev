# Ortus — rotina de assinaturas (gera a competência, marca atraso,
# bloqueia e reabre assinaturas).
# Disparada por ortus-assinaturas.timer. Não tem [Install]: quem liga é o timer.
#
# Rodar agora, à mão:  sudo systemctl start ortus-assinaturas.service
# Ver o resultado:     journalctl -u ortus-assinaturas.service -n 20 --no-pager

[Unit]
Description=Ortus - rotina: assinaturas e cobranças (GET /api/assinaturas/processar)
After=network-online.target ortus.service
Wants=network-online.target

[Service]
Type=oneshot
User=ortus
Group=ortus

Environment=ROTINA_TEMPO_MAX=120

ExecStart=/usr/local/bin/ortus-chamar-rotina assinaturas "/api/assinaturas/processar"
TimeoutStartSec=300
SyslogIdentifier=ortus-assinaturas

# ---- Endurecimento ----
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# Este serviço só fala com o próprio site, na própria máquina.
IPAddressDeny=any
IPAddressAllow=localhost
