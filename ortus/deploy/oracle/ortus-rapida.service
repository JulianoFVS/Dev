# Ortus — rotina rápida: envia a fila do Google Agenda, lê os
# compromissos do Google e avisa o suporte das mensagens que ninguém viu.
# Disparado por ortus-rapida.timer. Não tem [Install]: quem liga é o timer.
#
# Rodar agora, à mão:  sudo systemctl start ortus-rapida.service
# Ver o resultado:     journalctl -u ortus-rapida.service -n 20 --no-pager

[Unit]
Description=Ortus - rotina rápida (/api/rotinas/rapida)
After=network-online.target ortus.service
Wants=network-online.target

[Service]
Type=oneshot
User=ortus
Group=ortus

Environment=ROTINA_TEMPO_MAX=60

ExecStart=/usr/local/bin/ortus-chamar-rotina rapida "/api/rotinas/rapida"
TimeoutStartSec=180
SyslogIdentifier=ortus-rapida

# ---- Endurecimento ----
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# Este serviço só fala com o próprio site, na própria máquina.
IPAddressDeny=any
IPAddressAllow=localhost
