# Ortus — variáveis de ambiente da VM (modelo, sem valor de verdade).
#
# Vira /etc/ortus/ortus.env: dono root, grupo ortus, modo 0640, fora do git.
#   sudo install -o root -g ortus -m 0640 /opt/ortus/deploy/oracle/ortus.env.exemplo /etc/ortus/ortus.env
#   sudoedit /etc/ortus/ortus.env
#
# Quem lê:
#   ortus.service            (site)               EnvironmentFile=
#   ortus-whatsapp.service   (gateway, opcional)  EnvironmentFile=
#   ortus-chamar-rotina      (timers)             só as linhas CRON_SECRET e PORT
#   build                    (systemd-run ... npm run build)
#
# Formato (é o do systemd, não o de um script de shell):
#   - uma variável por linha: NOME=valor, sem espaço em volta do "=";
#   - sem aspas em volta do valor. Espaço no meio é mantido e "$" não é
#     interpretado;
#   - não use "\" no valor: para o systemd é caractere de escape. Se uma
#     senha tiver "\", gere outra;
#   - comentário só em linha própria, começando com "#". Depois de um valor,
#     "# ..." vira parte do valor.
#
# Troque todo marcador <SEU_...> / <SUA_...>. As linhas marcadas "opcional"
# ficam vazias depois do "=" quando não forem usadas: um marcador esquecido
# conta como valor e o site tenta usar.
# Conferir que não sobrou marcador (não pode imprimir nada):
#   sudo grep -nE '^[^#]*<(SEU|SUA)' /etc/ortus/ortus.env
#
# Mudou qualquer linha: sudo systemctl restart ortus  (e ortus-whatsapp, se usar).
# Mudou uma NEXT_PUBLIC_*: ela é copiada para dentro do build. Rode o build de
# novo antes de reiniciar.
#
# Não ponha aqui WHATSAPP_GATEWAY_HOST, WHATSAPP_GATEWAY_PORT,
# WHATSAPP_DATA_DIR nem PUPPETEER_EXECUTABLE_PATH: quem define é a unidade
# ortus-whatsapp.service, e o que está neste arquivo passa por cima dela.
# WHATSAPP_GATEWAY_AUTOSTART e WHATSAPP_GATEWAY_EXPOSE não se usam na VM (as
# unidades tiram as duas do ambiente).

# ---- Processo do site ----
NODE_ENV=production
# Porta do Next. O Nginx e os timers contam com 3500.
PORT=3500
# O `next start` não lê esta variável (o endereço é fixado na unidade
# ortus.service com --hostname). Fica aqui por registro.
HOSTNAME=127.0.0.1

# ---- Endereço público ----
# Com https e sem barra no fim. Entra nos links de e-mail, de anamnese e de
# retorno do pagamento. Atrás do Nginx o Next enxerga a própria URL como
# 127.0.0.1:3500: sem esta variável o e-mail sai sem link e o link de
# anamnese pode sair com esse endereço interno.
NEXT_PUBLIC_APP_URL=https://ortus.exemplo.com.br

# ---- Supabase (obrigatórias) ----
NEXT_PUBLIC_SUPABASE_URL=<SUA_URL_DO_PROJETO_SUPABASE>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUA_CHAVE_ANON>
# Só servidor. Ignora a RLS: quem tem esta chave lê e escreve tudo.
SUPABASE_SERVICE_ROLE_KEY=<SUA_CHAVE_SERVICE_ROLE>
# Opcional. O site não lê; só os scripts de banco (npm run db:migrate etc.).
# Pooler do Supabase, porta 6543. Deixe vazio se não for rodar script daqui.
DATABASE_URL=

# ---- Rotinas agendadas (obrigatória) ----
# Gere na VM: openssl rand -hex 32
# Sem ela as rotas /api/*/processar e /api/saude/vigia respondem 401.
CRON_SECRET=<SEU_SEGREDO_DAS_ROTINAS>

# ---- E-mail (Resend) ----
# Opcionais, mas sem as duas não sai lembrete, convite nem alerta por e-mail.
# Remetente num domínio verificado na Resend. Pode ter nome: Ortus <endereco>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- SMS (Twilio) — opcional, só se usar SMS ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- WhatsApp ----
# O gateway roda nesta VM, só em 127.0.0.1:3920 (ortus-whatsapp.service).
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3920
# Opcional (obrigatória se o gateway rodar aqui). Gere: openssl rand -hex 32
WHATSAPP_GATEWAY_SECRET=
# 1 quando o gateway roda nesta VM; 0 quando não existe (esconde a aba).
NEXT_PUBLIC_WHATSAPP_ATIVO=0

# ---- Cloudflare R2 (fotos, logos e documentos) ----
# Opcionais em conjunto: sem as três primeiras o site usa o Storage do Supabase.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLICO=ortus-publico
R2_BUCKET_PRIVADO=ortus-privado
# Opcional: domínio público do bucket. Vazio = o site serve a mídia pública.
R2_PUBLIC_URL=

# ---- Pagamento ----
PAGAMENTO_PROVEDOR=mercadopago
# Opcionais até a cobrança entrar em uso.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---- Suporte (aparecem no site) — opcionais ----
# Só dígitos, com DDI e DDD, no formato <DDI><DDD><NUMERO>. Vazio = a tela
# avisa que o contato ainda não foi configurado.
NEXT_PUBLIC_SUPORTE_WHATSAPP_1=
NEXT_PUBLIC_SUPORTE_WHATSAPP_2=

# ---- Avisos aos donos (relatos de suporte e alertas) — opcional ----
# E-mails separados por vírgula. Vazio = o e-mail de login de cada dono da
# plataforma.
ALERTA_EMAILS=
